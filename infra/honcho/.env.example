# Self-hosted Honcho + local embeddings (EmbeddingGemma via Ollama).
# Reference for the .env of the Honcho server (copy it by hand into the plastic-labs/honcho folder).

LOG_LEVEL=INFO
AUTH_USE_AUTH=false

# --- Embeddings: local, Google EmbeddingGemma (768 dims) --------------------------
# IMPORTANT: the dimension is baked into the pgvector schema at the FIRST migration.
# Changing the model or dimension later means recreating the DB volume (docker compose down -v).
EMBEDDING_VECTOR_DIMENSIONS=768
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=embeddinggemma
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=OLLAMA_API_KEY
# Ollama does not need `dimensions=` in the request; the model returns 768 itself.
EMBEDDING_MODEL_CONFIG__DIMENSIONS_MODE=never
EMBEDDING_MODEL_CONFIG__MAX_BATCH_SIZE=32
EMBEDDING_MAX_INPUT_TOKENS=2048
OLLAMA_API_KEY=ollama

# --- LLM for deriver/dialectic/summary/dream (Honcho will not start without it) -------------
# Option A: Gemini API (cheap, supports tool calling).
LLM_GEMINI_API_KEY=
DERIVER_MODEL_CONFIG__TRANSPORT=gemini
DERIVER_MODEL_CONFIG__MODEL=gemini-2.5-flash
SUMMARY_MODEL_CONFIG__TRANSPORT=gemini
SUMMARY_MODEL_CONFIG__MODEL=gemini-2.5-flash
DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=gemini
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=gemini-2.5-flash
DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=gemini
DREAM_INDUCTION_MODEL_CONFIG__MODEL=gemini-2.5-flash
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=gemini
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=gemini-2.5-flash
DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=gemini
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=gemini-2.5-flash
DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=gemini
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=gemini-2.5-flash
DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=gemini
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=gemini-2.5-pro
DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=gemini
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=gemini-2.5-pro

# Option B: fully local LLM via Ollama/vLLM (the model MUST support tool calling).
# Replace TRANSPORT=gemini with openai in each block above and add:
#   <SECTION>_MODEL_CONFIG__OVERRIDES__BASE_URL=http://host.docker.internal:11434/v1
#   <SECTION>_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=OLLAMA_API_KEY
#   <SECTION>_MODEL_CONFIG__MODEL=qwen3:14b
